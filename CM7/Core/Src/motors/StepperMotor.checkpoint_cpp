//-----------------------------------------------------------------------------
//                               init
//-----------------------------------------------------------------------------
void StepperMotor::init() 
{    
    m_motor_status       = FOC_MOTOR_STATUS::INITIALIZING;

    // TODO PID
   // m_PID_velocity.limit = (PHASE_RESISTANCE > 0.0f)
    //                     ? m_current_limit
     //                    : m_voltage_limit;

   // m_PID_angle.limit      = m_velocity_limit;

    // if using open loop control, set a CW as the default direction if not already set
    if (  (  m_controller == MOTION_CONTROL_TYPE::OL_ANGLE
             ||
		     m_controller == MOTION_CONTROL_TYPE::OL_VELOCITY
		  )
          &&
		  (m_sensor_direction == Direction::UNKNOWN))
    {
        m_sensor_direction = Direction::CW;
    }

    HAL_Delay(500);
    enable();   // enable motor
    HAL_Delay(500);

    m_motor_status = FOC_MOTOR_STATUS::UNCALIBRATED;
}


//-----------------------------------------------------------------------------
//
//-----------------------------------------------------------------------------
void StepperMotor::disable()
{
  m_driver.disable();
  
  m_enabled = false;
}

//-----------------------------------------------------------------------------
//
//-----------------------------------------------------------------------------
void StepperMotor::enable()
{
  m_driver.enable();

  m_enabled = true;
}

//-----------------------------------------------------------------------------
//                                initFOC
//
// return true on success
//-----------------------------------------------------------------------------
bool  StepperMotor::initFOC() 
{
    init(); // TODO: should this be 'reset'?

    bool success(true);


    m_sensor.get_diagnostic(); // dummy read
  
    m_motor_status = FOC_MOTOR_STATUS::UNCALIBRATED;

    // align motor if necessary
    // alignment necessary for encoders!
    // sensor and motor alignment - can be skipped
    // by setting motor.sensor_direction and motor.zero_electric_angle
    HAL_Delay(500);

    success &= alignSensor(); // bitwise intentional

    m_sensor.update();
    m_shaft_angle = m_sensor.get_angle_radians();

    if(success)
    {
    	m_motor_status = FOC_MOTOR_STATUS::READY;
    }
    else
    {
    	m_motor_status = FOC_MOTOR_STATUS::CALIBRATION_FAILED;
        disable();
    }

    return success;
}

//-----------------------------------------------------------------------------
//                            alignSensor
//
// Encoder alignment to electrical 0 angle
//
// return true on success
//-----------------------------------------------------------------------------
bool StepperMotor::alignSensor()
{
  const uint32_t TWO_MILLISECONDS(2);
  bool success(true);

  if(Direction::UNKNOWN == m_sensor_direction)
  {
   // if(needsSearch()) // TODO: need a clearer func name
    {
        success = absoluteZeroSearch();
    }
    
    // exit if index not found
    if(!success)
    {
        return success;
    }
    
    // find natural direction
    // move one electrical revolution forward
    // ramp up from 1.5Pi to 3.5Pi
    float electric_angle;

    // This should result in the motor spinning
    for (int i = 0; i <=500; i++ )
    {

        //char  buff[128];
        //sprintf(buff, "INC: %d\r\n", i);
        //HAL_UART_Transmit(&huart2, reinterpret_cast<uint8_t *>(buff), strlen(buff), HAL_MAX_DELAY);


        electric_angle = THREE_HALVES_PI + TWO_PI * i / 500.0f;
      
        setPhaseVoltage(m_voltage_sensor_align, 0.0f,  electric_angle);

        m_sensor.update();

	    HAL_Delay(TWO_MILLISECONDS);

        m_sensor.update();        
    }
    
    // take and angle in the middle
    m_sensor.update();
    
    float mid_angle = m_sensor.get_angle_radians(); //m_shaft_angle; 
    
    // move one electrical revolution backwards
    // ramp down from 3.5Pi to 1.5Pi
    for (int i = 500; i >=0; i-- ) 
    {

        //char  buff[128];
        //sprintf(buff, "DEC: %d\r\n", i);
        //HAL_UART_Transmit(&huart2, reinterpret_cast<uint8_t *>(buff), strlen(buff), HAL_MAX_DELAY);
    
        electric_angle = THREE_HALVES_PI + TWO_PI * i / 500.0f ;
        setPhaseVoltage(m_voltage_sensor_align, 0.0f,  electric_angle);
        
	    m_sensor.update();

	    HAL_Delay(TWO_MILLISECONDS);

        m_sensor.update();
    }
    
    m_sensor.update(); // TODO: shouldn't this be after setPhaseVoltage?
    
    float end_angle = m_sensor.get_angle_radians(); //m_shaft_angle; 
    
    setPhaseVoltage(0, 0, 0);                     // <---explain

    HAL_Delay(200);
    
    setPhaseVoltage(0.0f, 0.0f,  electric_angle); // <--explain THREE_HALVES_PI?
    HAL_Delay(TWO_MILLISECONDS);

    // determine the direction the sensor moved
    if (mid_angle == end_angle)
    {
      return 0; // failed calibration
    }
    else
    if (mid_angle < end_angle)
    {
        m_sensor_direction = Direction::CCW;
    }
    else
    {
        m_sensor_direction = Direction::CW;
    }

    
    float electrical_radians = 
          mechanical_to_electrical_radians(fabs(mid_angle - end_angle));
    
    if( fabs(electrical_radians - TWO_PI) > 0.5f )
    { 
        // 0.5f is arbitrary number it can be lower or higher!
    }
  }


  // zero electric angle not known
  if(NOT_SET == m_zero_electric_angle)
  {
      // align the electrical phases of the motor and sensor
      // set angle -90(270 = 3PI/2) degrees
      setPhaseVoltage(m_voltage_sensor_align, 0,  THREE_HALVES_PI);

      HAL_Delay(700);

      m_sensor.update();
      
      // get the m_amperage zero electric angle
      m_zero_electric_angle = get_electric_angle_radians();


      m_sensor_offset = m_zero_electric_angle; // TODO: Added but Not sure about this



      char  buff[128];
      sprintf(buff, "Zero Electric Angle: %ld\r\n", static_cast<uint32_t>(1000*m_zero_electric_angle));
      HAL_UART_Transmit(&huart2, reinterpret_cast<uint8_t *>(buff), strlen(buff), HAL_MAX_DELAY);
      
      HAL_Delay(20);

      // stop everything
      setPhaseVoltage(0.0f, 00.0f, 0.0f);

      HAL_Delay(200);
  }
  
  return success;
}

//-----------------------------------------------------------------------------
//                          absoluteZeroSearch
//
// Encoder alignment the absolute zero angle - to the index
//
// return true if search is complete
//-----------------------------------------------------------------------------
bool StepperMotor::absoluteZeroSearch()
{
    // Push limits
    float limit_vel    = m_velocity_limit;
    float limit_volt   = m_voltage_limit;
    
    m_velocity_limit   = m_velocity_index_search;
    m_voltage_limit    = m_voltage_sensor_align;
    
    // search the absolute zero with small velocity  
    m_shaft_angle      = 0.0f;
    
    while(needsSearch() && m_shaft_angle < TWO_PI)
    {
      angleOpenloop(THREE_PI);
      
      // update is important for some sensors not to loose count
      // not needed for the search
      m_sensor.update();
    }
    
    // disable motor
    setPhaseVoltage(0.0f, 0.0f, 0.0f); // TODO: refactor name
    
    // Pop limits
    m_velocity_limit = limit_vel;
    m_voltage_limit  = limit_volt;

    return !needsSearch();
}


//-----------------------------------------------------------------------------
//                               loopFOC
//
// Iterative function looping FOC algorithm, setting Uq on the Motor
// The faster it can be run the better
//-----------------------------------------------------------------------------
void StepperMotor::loopFOC() 
{
    const uint32_t TWO_MILLISECOND(2);

    const uint32_t MICROSECONDS_PER_SECOND( 1e-6f); // TODO move to class level
    
    unsigned long now_us = _micros();
    
    float delta_t           = (now_us - m_target_prev_timestamp)
                            * MICROSECONDS_PER_SECOND;
    
    m_target_prev_timestamp = now_us;
    
    m_sensor.update();

    m_shaft_angle = m_sensor.get_angle_radians();
    m_shaft_angle = adjust_shaft_angle_radians(m_shaft_angle);  

    
    //char buff[50];
   // sprintf(buff, "res:%ld\r\n", static_cast<uint32_t>(1000.0f *m_shaft_angle));
    //HAL_UART_Transmit(&huart2, reinterpret_cast<uint8_t *>(buff), strlen(buff), HAL_MAX_DELAY);

    // Needs the update() to be called first
    // This function will not have numerical issues because it uses Sensor::getMechanicalAngle() 
    // which is in range 0-2PI
  //  m_electrical_angle = get_electric_angle_radians(); // TODO: check this


    switch (m_controller) 
      {
        case MOTION_CONTROL_TYPE::TORQUE:
                         
             break;             
        
        case MOTION_CONTROL_TYPE::CL_ANGLE:
             
             cl_set_dq_voltage_angle(m_target, delta_t);
    
             break;
             
             
        case MOTION_CONTROL_TYPE::CL_VELOCITY:
    
             cl_set_dq_voltage_omega(m_target,  delta_t);
                                  
             break;
             
        case MOTION_CONTROL_TYPE::OL_VELOCITY:

             ol_set_dq_voltage_omega(m_target,  delta_t);

             break;
        
        case MOTION_CONTROL_TYPE::OL_ANGLE:
    
             ol_set_dq_voltage_angle(m_target,  delta_t);
             
             break;
    
        default:
             ; // NOP
    }

}

//-----------------------------------------------------------------------------
//                             move
//
// Iterative function running outer loop of the FOC algorithm
// Behavior of this function is determined by the motor.controller variable
// It runs either angle, velocity or voltage loop
// - needs to be called iteratively it is asynchronous function
// - if target is not set it uses motor.target value
// 
// voltage and current elements are in quatrature/Direct coordinate system
//-----------------------------------------------------------------------------
void StepperMotor::move(float new_target) 
{
    const uint32_t MICROSECONDS_PER_SECOND( 1e-6f); // TODO move to class level
    
    unsigned long now_us = _micros();
    
    float delta_t           = (now_us - m_target_prev_timestamp)
                            * MICROSECONDS_PER_SECOND;
    float delta_target      = new_target - m_target_prev;
    m_target_prev           = new_target;
    m_target_prev_timestamp = now_us;
    

    // downsampling (optional)
    if(m_motion_cnt++ < m_motion_downsample)
    {
        return;
    }
    
    m_motion_cnt = 0;

    // shaft angle/velocity need the update() to be called first
    // get shaft angle
    // TODO sensor precision: the shaft_angle actually stores the complete position, 
    //                        including full rotations, as a float. For this 
    //                        reason it is NOT precise when the angles become large.
    //                        Additionally, the way LPF works on angle is a precision 
    //                        issue, and the angle-LPF is a problem
    //                        when switching to a 2-component representation.

    // Why would this update be conditional
    // m_omega_mechanical_rps is needed for current.d
    //
    //if(  m_controller!=MOTION_CONTROL_TYPE::ANGLE_OPEN_LOOP
     //    && 
     //    m_controller!=MOTION_CONTROL_TYPE::VELOCITY_OPEN_LOOP
    //  ) 
    if(true)  
    {
        // read value even if motor iif not in openloop mode
        m_sensor.update();
        m_shaft_angle = m_sensor.get_angle_radians();
        m_shaft_angle = adjust_shaft_angle_radians(m_shaft_angle); 
    }

    m_omega_mechanical_rps = shaft_radians_per_second();
    //m_omega_electrical_rps = m_omega_mechanical_rps * NUM_POLE_PAIRS;


    if(!m_enabled)
    {
       return;
    }

    // set internal m_target variable
    if(NOT_SET != new_target ) 
    {
        m_target = new_target;
    }

    // calculate back-emf m_voltage if KV_rating available U_bemf = vel*(1/KV)
    if (NOT_SET != KV_RPM_PER_VOLT)
    {
        float rpm = m_omega_mechanical_rps * RAD_PER_SEC_TO_REV_PER_MIN;
        m_voltage_bemf = rpm/KV_RPM_PER_VOLT;
    }

    // estimate motor m_amperage if phase resistance available and 
    // current_sense not available
    if(!m_p_current_sense && (PHASE_RESISTANCE > 0.0f))
    {
        // Ohm's law
        // m_amperage appears to be set but not used
        m_amperage.q = (m_voltage.q - m_voltage_bemf)/PHASE_RESISTANCE;
    }

    // choose control loop
    switch (m_controller) 
    {
      case MOTION_CONTROL_TYPE::TORQUE:

           // In this context, the new_target has units of volts
           // The quadrature voltage controls the torque

           set_dq_voltage_torque(new_target, delta_t, delta_target);
                       
           break;
           
      
      case MOTION_CONTROL_TYPE::CL_ANGLE:

           m_target = new_target * NUM_POLE_PAIRS;       

           break;
           
           
      case MOTION_CONTROL_TYPE::CL_VELOCITY:

           m_target = new_target  * NUM_POLE_PAIRS;    
                                
           break;
           
      case MOTION_CONTROL_TYPE::OL_VELOCITY:
           
           m_target = new_target  * NUM_POLE_PAIRS;  
  
           break;
           
      case MOTION_CONTROL_TYPE::OL_ANGLE:

           m_target = new_target  * NUM_POLE_PAIRS;  

          
           
           break;

      default:
           ; // NOP
  }
}

void StepperMotor::set_dq_voltage_torque(float target_quadrature_voltage, float delta_t, float delta_target)
{
    //    I_qref = T_ref / K_t
    
      
      //  voltage_d = phase_resistance * current_q
      //              + phase_inductance * delta_current_q/delta_t
      //              + omega * (phase_inductance * current_d + V_emf)
      //
      // IF current_d = 0 current_q = target 
      //
      //  voltage_d = target * phase_resistance
      //              + phase_inductance * delta_target/delta_t
      //              + m_omega_electrical_rps * m_voltage_bemf
      
 #if 1
      float voltage_q(target_quadrature_voltage);  // Amps--> volts? just disable if no phase resistances 
      
      // divide by zero gaurd
      float delta_I_d = (fabs(delta_t) > 0.0f)
                      ? delta_target/delta_t
                      : 0.0f;

      // TODO: fetch a fresh mech rps
      float electrical_rps = mechanical_to_electrical_radians(m_omega_mechanical_rps);
                      
      voltage_q =  target_quadrature_voltage * PHASE_RESISTANCE 
                +  PHASE_INDUCTANCE * delta_I_d
                +  electrical_rps * m_voltage_bemf;
      
    
 #else
      // original formula
      float voltage_q = (PHASE_RESISTANCE > 0.0f)
                      ? m_target * PHASE_RESISTANCE + m_voltage_bemf
                      : m_target;                              // Amperes
 #endif
     m_voltage.q = symetric_clamp( voltage_q, 
                                   m_voltage_limit);
     
     // set d-component (lag compensation if known inductance)
     float voltage_d(0.0f);
     
     if(PHASE_INDUCTANCE > 0.0f)
     {
        // Assume current_d = 0
        // current_q comes from the pid this is the target and affects torque
        //
        //  voltage_d =  phase_resistance * target_Current_d
        //            +  phase_inductance * delta_current_d/delta_t
        //            -  omega * phase_inductance * current_q
        //
        // with current_d = 0, then delta_current_d/delta_t = 0
        // current_q = target
        //
        //  voltage_d =  -  omega * phase_inductance * target
    
        
    
         voltage_d =  -PHASE_INDUCTANCE
                   *   mechanical_to_electrical_radians(m_omega_mechanical_rps)
                   *   m_target;                                // Amperes
                
     }
    
    
    
      m_voltage.d = symetric_clamp( voltage_d, 
                                    m_voltage_limit);


     setPhaseVoltage(m_voltage.q, m_voltage.d, get_electric_angle_radians());

}


