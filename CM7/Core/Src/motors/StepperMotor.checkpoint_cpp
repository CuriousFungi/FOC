void StepperMotor::ol_set_dq_voltage_angle(float target_mechanical_radians, float delta_t)
{    
    const float MAX_RESISTIVE_VOLTAGE_DROP(m_current_limit*PHASE_RESISTANCE);

    // quick fix for strange cases (micros overflow + timestamp not defined)
    if(delta_t <= 0 || delta_t > 0.5f)
    {
      delta_t = 1e-3f;
    }

    // calculate the necessary angle to move from m_amperage position towards 
    // m_target angle with maximal velocity (m_velocity_limit)

    // Note: m_velocity_limit may have been modified by absoluteZeroSearch()
  
   // float target_electrical_radians = mechanical_to_electrical_radians(target_mechanical_radians);
    float shaft_angle(m_sensor.get_angle_radians());
    float target_angle_error(   target_mechanical_radians -  shaft_angle);  // TODO: make sure this is electrical
    float max_angular_change(     m_velocity_limit * delta_t    );
  
    if( abs( target_angle_error ) > abs( max_angular_change ))
    {
      shaft_angle += _sign(target_angle_error) * max_angular_change;
    
   //   m_omega_mechanical_rps = m_velocity_limit;       
    }
    else
    {
      shaft_angle          = target_mechanical_radians;
   //   m_omega_mechanical_rps = 0;   
    }

    shaft_angle -= m_zero_electric_angle;


    m_voltage.d = 0; // TODO d-component lag-compensation 
     

    float voltage_q  = MAX_RESISTIVE_VOLTAGE_DROP + fabs(m_voltage_bemf);
    m_voltage.q = symetric_clamp(voltage_q, m_voltage_limit);
 
    m_amperage.q = (m_voltage.q  - fabs(m_voltage_bemf))/PHASE_RESISTANCE;

    float raw_elec_angle(mechanical_to_electrical_radians(shaft_angle));
    float norm_elec_angle(normalize_radians(raw_elec_angle));
  
    setPhaseVoltage(m_voltage.q, m_voltage.d, norm_elec_angle);

    return;
}

