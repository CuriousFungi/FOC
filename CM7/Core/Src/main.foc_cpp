/* USER CODE BEGIN PV */




// bipolar, 400 steps/rev
// step angle 0.9 deg
// voltage 2.9
// inductance 4.0 mH +/- 20% at 1KHz
// current 2.0 amp
// holding torque 46Ncm(65.1 oz-inches)
StepperMotor stepper = StepperMotor(
                                     &hspi2,        //  sensor spi
                                     GPIOA,         //  p_sensor_chip_select_port,
                                     SPI2_CS_Pin,   //  sensor_chip_select_pin,
                                     50,            //  number of pole pairs
                                     212.0f,  //1.45f,         //  phase resistance
                                     1.0f,          // TODO: determine real  _KV, 
                                     3.2f,    //4.0f,          // mH inductance
                                     20.0f,         // voltage limit
                                     20.0f,         // power supply voltage limit L298N
                                     &htim1,
                                     &htim5,
                                     TIM_CHANNEL_1,  // tmr 1
                                     TIM_CHANNEL_2,  // tmr 1
                                     TIM_CHANNEL_1,  // tmr 5
                                     TIM_CHANNEL_2); // tmr 5




void enableCycleCounter(void)
{
  CoreDebug->DEMCR |= CoreDebug_DEMCR_TRCENA_Msk; // Enable DWT unit
  DWT->CYCCNT       = 0; // Reset cycle counter
  DWT->CTRL        |= DWT_CTRL_CYCCNTENA_Msk; // Enable cycle counter
}



